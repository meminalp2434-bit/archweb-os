using System;
using System.Diagnostics;
using System.IO;
using System.Runtime.InteropServices;

namespace ArchWebOS.Setup
{
    class Program
    {
        private const int STD_OUTPUT_HANDLE = -11;
        private const uint ENABLE_VIRTUAL_TERMINAL_PROCESSING = 0x0004;

        [DllImport("kernel32.dll", SetLastError = true)]
        static extern IntPtr GetStdHandle(int nStdHandle);

        [DllImport("kernel32.dll")]
        static extern bool GetConsoleMode(IntPtr hConsoleHandle, out uint lpMode);

        [DllImport("kernel32.dll")]
        static extern bool SetConsoleMode(IntPtr hConsoleHandle, uint dwMode);

        static void Main(string[] args)
        {
            EnableAnsi();
            Console.Title = "ArchWeb OS - Desktop Edition v20.1.2";

            PrintBanner();

            Console.WriteLine("\u001b[94m[SYSTEM]\u001b[0m Masaüstü ortamı yükleniyor...");

            if (!CheckNodeJs())
            {
                Console.WriteLine("\u001b[91m[HATA]\u001b[0m Node.js bulunamadı!");
                Console.WriteLine("Lütfen https://nodejs.org/ adresinden Node.js yükleyin.");
                Console.WriteLine("\nDevam etmek için bir tuşa basın...");
                Console.ReadKey();
                return;
            }

            Console.WriteLine("\u001b[92m[OK]\u001b[0m Node.js Runtime Hazır.");

            string targetIp = "127.0.0.1";
            string localWifiIp = "192.168.1.182";
            string targetPort = "3000";
            string devUrl = "https://ais-dev-xjjumj5lom3t4danhihlde-579357512949.europe-west2.run.app";
            string onlineUrl = "https://ais-pre-xjjumj5lom3t4danhihlde-579357512949.europe-west2.run.app";

            Console.WriteLine("\u001b[94m[INFO]\u001b[0m ArchWeb OS Sunucu Yapılandırması:");
            Console.WriteLine($"       > YEREL IP:     \u001b[93m{targetIp}:{targetPort}\u001b[0m");
            Console.WriteLine($"       > YEREL AĞ:     \u001b[93mhttp://{localWifiIp}:{targetPort}\u001b[0m");
            Console.WriteLine($"       > GELİŞTİRME:   \u001b[96m{devUrl}\u001b[0m");
            Console.WriteLine($"       > GENEL CANLI:  \u001b[92m{onlineUrl}\u001b[0m");
            Console.WriteLine("\u001b[95m------------------------------------------------------------\u001b[0m");
            Console.WriteLine("\u001b[1mDURUM: \u001b[92mAKTİF (ARCHWEB KERNEL ÇALIŞIYOR)\u001b[0m");
            Console.WriteLine("\u001b[94m[KERNEL]\u001b[0m Webview2 Runtime başlatılıyor...");
            Console.WriteLine("\u001b[94m[KERNEL]\u001b[0m Güvenli tünel oluşturuluyor...");
            Console.WriteLine("");

            try
            {
                ProcessStartInfo startInfo = new ProcessStartInfo
                {
                    FileName = "npm",
                    Arguments = "run dev",
                    UseShellExecute = true
                };
                Process.Start(startInfo);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"\u001b[91m[HATA]\u001b[0m Sunucu başlatılamadı: {ex.Message}");
            }

            Console.WriteLine("\u001b[93m[SİSTEM]\u001b[0m Kapatmak için bir tuşa basın...");
            Console.ReadKey();
        }

        static void PrintBanner()
        {
            Console.WriteLine("\u001b[96m\u001b[1m");
            Console.WriteLine("    █████╗ ██████╗  ██████╗██╗  ██╗██╗    ██╗███████╗██████╗ ");
            Console.WriteLine("    ██╔══██╗██╔══██╗██╔════╝██║  ██║██║    ██║██╔════╝██╔══██╗");
            Console.WriteLine("    ███████║██████╔╝██║     ███████║██║ █╗ ██║█████╗  ██████╔╝");
            Console.WriteLine("    ██╔══██║██╔══██╗██║     ██╔══██║██║███╗██║██╔══╝  ██╔══██╗");
            Console.WriteLine("    ██║  ██║██║  ██║╚██████╗██║  ██║╚███╔███╔╝███████╗██████╔╝");
            Console.WriteLine("    ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝ ╚══╝╚══╝ ╚══════╝╚═════╝ ");
            Console.WriteLine("                                   SYSTEM CORE v20.1.2\u001b[0m");
            Console.WriteLine("\u001b[95m------------------------------------------------------------\u001b[0m");
        }

        static bool CheckNodeJs()
        {
            try
            {
                ProcessStartInfo psi = new ProcessStartInfo("node", "--version")
                {
                    RedirectStandardOutput = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                };
                using (Process p = Process.Start(psi))
                {
                    p.WaitForExit();
                    return p.ExitCode == 0;
                }
            }
            catch { return false; }
        }

        static void EnableAnsi()
        {
            var hStdOut = GetStdHandle(STD_OUTPUT_HANDLE);
            if (GetConsoleMode(hStdOut, out uint outConsoleMode))
            {
                outConsoleMode |= ENABLE_VIRTUAL_TERMINAL_PROCESSING;
                SetConsoleMode(hStdOut, outConsoleMode);
            }
        }
    }
}
