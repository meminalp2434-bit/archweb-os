import os
import subprocess
import sys
import time

# ArchWeb OS ANSI Color Codes matching the system theme
CYAN = "\033[96m"
MAGENTA = "\033[95m"
BLUE = "\033[94m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
RESET = "\033[0m"

def print_banner():
    """Prints the ArchWeb OS stylized banner in system colors."""
    print(f"{CYAN}{BOLD}")
    print("    █████╗ ██████╗  ██████╗██╗  ██╗██╗    ██╗███████╗██████╗ ")
    print("    ██╔══██╗██╔══██╗██╔════╝██║  ██║██║    ██║██╔════╝██╔══██╗")
    print("    ███████║██████╔╝██║     ███████║██║ █╗ ██║█████╗  ██████╔╝")
    print("    ██╔══██║██╔══██╗██║     ██╔══██║██║███╗██║██╔══╝  ██╔══██╗")
    print("    ██║  ██║██║  ██║╚██████╗██║  ██║╚███╔███╔╝███████╗██████╔╝")
    print("    ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝ ╚══╝╚══╝ ╚══════╝╚═════╝ ")
    print(f"                                   SYSTEM CORE v20.1.2{RESET}")
    print(f"{MAGENTA}------------------------------------------------------------{RESET}")

def start_archweb():
    """Initializes environment and starts the development server."""
    # Ensure terminal supports colors on Windows
    if os.name == 'nt':
        os.system('')

    os.system('cls' if os.name == 'nt' else 'clear')
    print_banner()
    
    print(f"{BLUE}[SYSTEM]{RESET} Ortam denetleniyor...")
    
    # 1. Check for Node.js
    try:
        subprocess.run(["node", "--version"], check=True, capture_output=True)
        print(f"{GREEN}[OK]{RESET} Node.js Runtime Hazir.")
    except (subprocess.CalledProcessError, FileNotFoundError):
        print(f"{RED}[HATA]{RESET} Node.js bulunamadi!")
        print("Lutfen https://nodejs.org/ adresinden Node.js yukleyin.")
        input("\nDevam etmek icin bir tusa basin...")
        sys.exit(1)

    # 2. Check for dependencies
    if not os.path.exists("node_modules"):
        print(f"{YELLOW}[WARN]{RESET} Sistem bilesenleri eksik. Yukleniyor...")
        try:
            subprocess.run(["npm", "install"], check=True, shell=True)
        except subprocess.CalledProcessError:
            print(f"{RED}[HATA]{RESET} Kurulum sirasinda bir sorun olustu.")
            input("\nKapatmak icin bir tusa basin...")
            sys.exit(1)

    # 3. Configuration
    target_ip = "245.578.3.57.99"
    target_port = "5677"

    print(f"{BLUE}[INFO]{RESET} Sunucu Yapilandirmasi:")
    print(f"       > IP:   {YELLOW}{target_ip}{RESET}")
    print(f"       > PORT: {YELLOW}{target_port}{RESET}")
    print(f"       > URL:  {CYAN}http://localhost:{target_port}{RESET}")
    print(f"{MAGENTA}------------------------------------------------------------{RESET}")
    print(f"{BOLD}DURUM: {GREEN}AKTIF (ARCHWEB ENGINE CALISIYOR){RESET}")
    print("")
    print(f"{BLUE}[LOGS]{RESET} Sistem kayitlari baslatiliyor...")
    print("----------------------------------------------------")

    # 4. Launch the server
    try:
        subprocess.run(["npm", "run", "dev"], shell=True)
    except KeyboardInterrupt:
        print(f"\n{YELLOW}[SYSTEM]{RESET} Sunucu guvenli bir sekilde kapatildi.")

if __name__ == "__main__":
    start_archweb()
